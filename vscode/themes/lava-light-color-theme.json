{
  "$schema": "vscode://schemas/color-theme",
  "name": "Lava Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#b7472780",
    "foreground": "#34312f",
    "widget.shadow": "#00000066",
    "selection.background": "#e3e8ed",
    "editor.background": "#f8f7f3",
    "editor.foreground": "#34312f",
    "editor.lineHighlightBackground": "#eae7df",
    "editor.selectionBackground": "#e3e8ed",
    "editor.findMatchBackground": "#b7472766",
    "editor.findMatchHighlightBackground": "#87601c33",
    "editor.wordHighlightBackground": "#eae7df",
    "editorCursor.foreground": "#34312f",
    "editorLineNumber.foreground": "#8c857b",
    "editorLineNumber.activeForeground": "#b74727",
    "editorIndentGuide.background1": "#c9c4ba",
    "editorIndentGuide.activeBackground1": "#8c857b",
    "editorWhitespace.foreground": "#c9c4ba",
    "editorBracketMatch.border": "#b74727",
    "editorBracketMatch.background": "#eae7df",
    "editorError.foreground": "#b9382b",
    "editorWarning.foreground": "#87601c",
    "editorInfo.foreground": "#355f9d",
    "editorHint.foreground": "#246e61",
    "editorGutter.addedBackground": "#4e702d",
    "editorGutter.modifiedBackground": "#87601c",
    "editorGutter.deletedBackground": "#b9382b",
    "editorWidget.background": "#fffefa",
    "editorWidget.border": "#c9c4ba",
    "editorSuggestWidget.background": "#fffefa",
    "editorSuggestWidget.selectedBackground": "#e3e8ed",
    "editorSuggestWidget.highlightForeground": "#b74727",
    "editorHoverWidget.background": "#fffefa",
    "editorHoverWidget.border": "#c9c4ba",
    "editorGroupHeader.tabsBackground": "#eeece6",
    "editorGroup.border": "#c9c4ba",
    "tab.activeBackground": "#f8f7f3",
    "tab.activeForeground": "#34312f",
    "tab.activeBorderTop": "#b74727",
    "tab.inactiveBackground": "#eeece6",
    "tab.inactiveForeground": "#79736b",
    "tab.border": "#eeece6",
    "activityBar.background": "#eeece6",
    "activityBar.foreground": "#56514b",
    "activityBar.inactiveForeground": "#79736b",
    "activityBar.activeBorder": "#b74727",
    "activityBarBadge.background": "#b74727",
    "activityBarBadge.foreground": "#fafafa",
    "sideBar.background": "#eeece6",
    "sideBar.foreground": "#56514b",
    "sideBar.border": "#c9c4ba",
    "sideBarSectionHeader.background": "#eeece6",
    "sideBarTitle.foreground": "#56514b",
    "list.activeSelectionBackground": "#e3e8ed",
    "list.activeSelectionForeground": "#34312f",
    "list.inactiveSelectionBackground": "#eae7df",
    "list.hoverBackground": "#eae7df",
    "list.highlightForeground": "#b74727",
    "statusBar.background": "#eeece6",
    "statusBar.foreground": "#56514b",
    "statusBar.border": "#c9c4ba",
    "statusBar.debuggingBackground": "#b33b46",
    "statusBar.debuggingForeground": "#fafafa",
    "statusBarItem.remoteBackground": "#b74727",
    "statusBarItem.remoteForeground": "#fafafa",
    "titleBar.activeBackground": "#eeece6",
    "titleBar.activeForeground": "#56514b",
    "titleBar.inactiveBackground": "#eeece6",
    "titleBar.inactiveForeground": "#79736b",
    "panel.background": "#eeece6",
    "panel.border": "#c9c4ba",
    "panelTitle.activeBorder": "#b74727",
    "panelTitle.activeForeground": "#34312f",
    "panelTitle.inactiveForeground": "#79736b",
    "input.background": "#f8f7f3",
    "input.border": "#c9c4ba",
    "input.placeholderForeground": "#79736b",
    "button.background": "#b74727",
    "button.foreground": "#fafafa",
    "button.hoverBackground": "#b33b46",
    "badge.background": "#b74727",
    "badge.foreground": "#fafafa",
    "scrollbarSlider.background": "#8c857b66",
    "scrollbarSlider.hoverBackground": "#8c857b99",
    "scrollbarSlider.activeBackground": "#8c857b",
    "gitDecoration.addedResourceForeground": "#4e702d",
    "gitDecoration.modifiedResourceForeground": "#87601c",
    "gitDecoration.deletedResourceForeground": "#b9382b",
    "gitDecoration.untrackedResourceForeground": "#246e61",
    "gitDecoration.ignoredResourceForeground": "#79736b",
    "terminal.background": "#f8f7f3",
    "terminal.foreground": "#34312f",
    "terminalCursor.foreground": "#34312f",
    "terminal.ansiBlack": "#2b211d",
    "terminal.ansiRed": "#b9382b",
    "terminal.ansiGreen": "#4e702d",
    "terminal.ansiYellow": "#87601c",
    "terminal.ansiBlue": "#355f9d",
    "terminal.ansiMagenta": "#925080",
    "terminal.ansiCyan": "#246e61",
    "terminal.ansiWhite": "#56514b",
    "terminal.ansiBrightBlack": "#756860",
    "terminal.ansiBrightRed": "#a11e14",
    "terminal.ansiBrightGreen": "#3b5c17",
    "terminal.ansiBrightYellow": "#724c00",
    "terminal.ansiBrightBlue": "#224b87",
    "terminal.ansiBrightMagenta": "#7c3c6b",
    "terminal.ansiBrightCyan": "#045a4e",
    "terminal.ansiBrightWhite": "#34312f"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#736d65",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#4e702d"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#246e61"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#955436"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#34312f"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#b33b46",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#56514b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#276c7c"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ad442b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#925080"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#276c7c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#355f9d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#87601c"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#87601c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#b33b46"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#87601c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#925080"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#56514b"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ad442b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#355f9d"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#4e702d"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4e702d"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#87601c"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b9382b"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#b9382b"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#56514b",
      "italic": true
    },
    "property": "#276c7c",
    "enumMember": "#955436",
    "namespace": "#87601c",
    "variable.defaultLibrary": "#b33b46",
    "function.defaultLibrary": {
      "foreground": "#355f9d",
      "italic": true
    },
    "type.defaultLibrary": {
      "foreground": "#87601c",
      "italic": true
    }
  }
}
